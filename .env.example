# Ilova sozlamalari
APP_NAME=Ratsiya Backend
DEBUG=True

# PostgreSQL ma'lumotlar bazasi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ratsiya_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ratsiya_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT autentifikatsiya
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — ruxsat etilgan domenlar (vergul bilan, yoki "*" hamma uchun)
# Production: https://frontend.domeningiz.uz
CORS_ORIGINS=*

# Ovozli xabar sozlamalari
VOICE_MESSAGE_TTL=60
MAX_VOICE_DURATION_SECONDS=20

# Uvicorn (production - worker soni)
UVICORN_WORKERS=1